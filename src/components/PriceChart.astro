---
/**
 * Ilustrační graf: nabídková cena v inzerci vs. realizovaná cena z katastru.
 * Data jsou UKÁZKOVÁ – programátor napojí na skutečná čísla (data/market.json), makléř je aktualizuje.
 */
interface Props { class?: string; dark?: boolean }
const { class: cls = '', dark = false } = Astro.props;
const grid = dark ? '#3a3733' : '#e2ded6';
const txt = dark ? '#a8a49c' : '#7a766e';
const ask = dark ? '#7f7a72' : '#9aa3ad';
const real = dark ? '#c9636f' : '#6b1e2f';
const months = ['IX', 'X', 'XI', 'XII', 'I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const nabidkova = [71, 72, 72, 73, 74, 75, 76, 76, 77, 78, 79, 80]; // tis. Kč/m²
const realizovana = [64, 64, 65, 65, 66, 67, 67, 68, 69, 69, 70, 71];
const W = 640, H = 260, PL = 44, PR = 12, PT = 16, PB = 34;
const min = 58, max = 84;
const x = (i: number) => PL + (i * (W - PL - PR)) / (months.length - 1);
const y = (v: number) => PT + ((max - v) * (H - PT - PB)) / (max - min);
const path = (arr: number[]) => arr.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const ticks = [60, 70, 80];
---
<figure class:list={[dark ? 'border border-white/10 bg-white/[0.03] p-5 text-white' : 'border border-line bg-paper p-5', cls]}>
  <figcaption class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
    <span class="font-medium">Byty ve Vyškově, cena za m²</span>
    <span class:list={['text-sm', dark ? 'text-white/50' : 'text-mute']}>ukázková data · 12 měsíců</span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="Graf: nabídkové ceny v inzerci rostou rychleji než realizované ceny z katastru; rozdíl je zhruba 9 tisíc korun na metr čtvereční.">
    {ticks.map((t) => (
      <g>
        <line x1={PL} x2={W - PR} y1={y(t)} y2={y(t)} stroke={grid} stroke-width="1" />
        <text x={PL - 8} y={y(t) + 4} text-anchor="end" font-size="12" fill={txt}>{t} tis.</text>
      </g>
    ))}
    {months.map((m, i) => (
      <text x={x(i)} y={H - 12} text-anchor="middle" font-size="11" fill={txt}>{m}</text>
    ))}
    <path d={path(nabidkova)} fill="none" stroke={ask} stroke-width="2.5" stroke-dasharray="6 5" />
    <path d={path(realizovana)} fill="none" stroke={real} stroke-width="3" />
    <circle cx={x(11)} cy={y(realizovana[11])} r="5" fill={real} />
    <circle cx={x(11)} cy={y(nabidkova[11])} r="4" fill={ask} />
  </svg>
  <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
    <li class="flex items-center gap-2"><span class="inline-block h-[3px] w-6" style={`background:${real}`}></span>realizované ceny (katastr)</li>
    <li class="flex items-center gap-2"><span class="inline-block h-[3px] w-6 border-t-[3px] border-dashed" style={`border-color:${ask}`}></span>nabídkové ceny (inzerce)</li>
  </ul>
</figure>
