---
/** Karta makléře – do detailu nemovitosti a kontaktu. */
import { site } from '@/data/site';
interface Props { class?: string; note?: string }
const { class: cls = '', note = 'Zavolejte, nebo napište – odpovídám i o víkendu.' } = Astro.props;
const b = site.broker;
---
<div class:list={['flex items-center gap-4', cls]}>
  <img src={b.photo} alt={`${b.name}`} width="72" height="72" class="h-[72px] w-[72px] rounded-full object-cover" loading="lazy" />
  <div class="min-w-0">
    <p class="font-semibold leading-tight">{b.name}</p>
    <p class="text-sm text-mute">{b.role}</p>
    <a href={b.phoneHref} class="mt-1 block font-medium text-ink hover:text-wine">{b.phone}</a>
    {note && <p class="mt-1 text-sm text-ink-soft">{note}</p>}
  </div>
</div>
