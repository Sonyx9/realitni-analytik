---
/**
 * Logotyp: dvouřádkový serifový wordmark se značkou "měřítka" – tři svislé čárky různé
 * výšky (odkaz na graf / měření), ne domeček. Vektorové, škáluje se s velikostí písma.
 */
import { site } from '@/data/site';
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
const img = light ? site.logoLight || site.logo : site.logo;
---
<a href="/" class={`group inline-flex items-center gap-2.5 ${cls}`} aria-label="Realitní analytik – úvodní stránka">
  {img ? (
    <img src={img} alt={site.name} height="36" class="h-9 w-auto" />
  ) : (<>
  <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" class="shrink-0">
    <rect x="1" y="1" width="28" height="28" rx="5" fill={light ? '#ffffff' : '#1f2933'} />
    <rect x="7" y="17" width="3" height="7" fill={light ? '#1f2933' : '#ffffff'} />
    <rect x="13.5" y="11" width="3" height="13" fill={light ? '#1f2933' : '#ffffff'} />
    <rect x="20" y="6" width="3" height="18" fill="#6b1e2f" />
  </svg>
  <span class={`font-serif text-[1.35rem] leading-none tracking-[-0.01em] ${light ? 'text-white' : 'text-ink'}`} style="font-variation-settings: 'opsz' 24">
    Realitní <span class="font-medium">analytik</span>
  </span>
  </>)}
</a>
