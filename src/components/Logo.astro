---
import { site } from '@/data/site';
import officialLogo from '@/assets/logo-realitni-analytik.png';
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
const img = light ? site.logoLight || officialLogo.src : site.logo || officialLogo.src;
---
<a href="/" data-logo-link class={`group inline-flex items-center ${cls}`} aria-label="Realitní analytik – úvodní stránka">
  <img
    data-logo
    src={img}
    alt={site.name}
    width="277"
    height="280"
    class:list={[
      'w-auto object-contain',
      light ? 'h-16 rounded-sm bg-white p-1.5' : 'h-14 lg:h-28',
    ]}
  />
</a>
