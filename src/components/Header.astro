---
import Logo from './Logo.astro';
import { nav, site } from '@/data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
/** v5: hlavička je na všech stránkách světlá a sticky (úvod má světlé hero). Overlay varianta zůstává pro případ tmavého hero. */
const overlay = false;
---
<header
  class:list={[
    'top-0 z-40 w-full transition-colors duration-300',
    overlay ? 'absolute text-white' : 'sticky border-b border-line bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/85',
  ]}
  data-header
  data-overlay={overlay ? 'true' : undefined}
>
  <div class="container-x flex h-[76px] items-center justify-between gap-6">
    <Logo light={overlay} />

    <nav aria-label="Hlavní navigace" class="hidden items-center gap-7 whitespace-nowrap lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-[11px] font-medium uppercase tracking-[0.16em] transition-opacity hover:opacity-100',
            overlay ? 'text-white opacity-80' : 'text-ink opacity-70',
            { 'opacity-100 underline decoration-wine decoration-2 underline-offset-[10px]': isActive(item.href) },
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-5 whitespace-nowrap lg:flex">
      <a href={site.broker.phoneHref} class:list={['num hidden text-[0.9rem] font-medium xl:inline', overlay ? 'text-white' : 'text-ink']}>{site.broker.phone}</a>
      <a href="/oceneni-nemovitosti-zdarma/" class:list={['btn-ghost', overlay ? 'btn-ghost-light' : 'btn-ghost-dark']}>Ocenit nemovitost</a>
    </div>

    <button
      type="button"
      class:list={['inline-flex h-11 w-11 items-center justify-center border lg:hidden', overlay ? 'border-white/50 text-white' : 'border-line text-ink']}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only">Otevřít menu</span>
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" /></svg>
    </button>
  </div>

  <div id="mobile-menu" hidden class="border-t border-line bg-paper text-ink lg:hidden">
    <nav aria-label="Mobilní navigace" class="container-x flex flex-col py-3">
      {nav.map((item) => (
        <a href={item.href} class="border-b border-line py-3.5 text-[13px] font-medium uppercase tracking-[0.14em] last:border-0">{item.label}</a>
      ))}
      <div class="mt-3 flex flex-col gap-3 pb-2">
        <a href="/oceneni-nemovitosti-zdarma/" class="btn btn-primary">Ocenění nemovitosti zdarma</a>
        <a href={site.broker.phoneHref} class="btn btn-outline">Zavolat {site.broker.phone}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const header = document.querySelector<HTMLElement>('[data-header]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    // na úvodu při otevřeném menu dočasně plná hlavička
    if (header?.dataset.overlay) header.classList.toggle('is-open', !open);
  });
</script>
<style>
  [data-overlay].is-open { background: var(--color-paper); color: var(--color-ink); }
  [data-overlay].is-open a, [data-overlay].is-open button { color: var(--color-ink); border-color: var(--color-line); }
</style>
