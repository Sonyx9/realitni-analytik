---
import Logo from './Logo.astro';
import { nav, site } from '@/data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-40 w-full border-b border-line bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/90" data-header>
  <div class="container-x flex h-16 items-center justify-between gap-4 lg:h-[76px]">
    <Logo class="relative z-10 lg:self-start lg:rounded-b-sm lg:bg-paper lg:p-2" />

    <nav aria-label="Hlavní navigace" class="hidden items-center gap-5 whitespace-nowrap lg:flex xl:gap-6">
      {nav.map((item) => (
        <a href={item.href} class:list={['border-b-2 border-transparent py-2 text-sm font-medium text-ink-soft transition-colors hover:text-ink', { 'border-wine text-ink': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-2 whitespace-nowrap lg:flex">
      <a href={site.broker.phoneHref} class="btn btn-outline num inline-flex" aria-label={`Zavolat ${site.broker.phone}`}>{site.broker.phone}</a>
      <a href="/oceneni-nemovitosti-zdarma/" class="btn btn-primary hidden xl:inline-flex">Ocenit nemovitost</a>
    </div>

    <a
      href={site.broker.phoneHref}
      class="btn btn-primary ml-auto inline-flex h-11 shrink-0 gap-2 px-4 text-sm lg:hidden"
      aria-label={`Zavolat ${site.broker.phone}`}
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.2 1.6a1 1 0 0 0-1.3-.3L2.3 2.2A2 2 0 0 0 1.4 4.5c.5 2.2 1.7 4.3 3.4 6s3.8 2.9 6 3.4a2 2 0 0 0 2.3-1l.9-1.5a1 1 0 0 0-.3-1.3l-2.2-1.5a1 1 0 0 0-1.3.2l-.7.8a10.6 10.6 0 0 1-3.1-3.1l.8-.7a1 1 0 0 0 .2-1.3z"/></svg>
      Zavolat
    </a>

    <button type="button" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-sm border border-line text-ink lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Otevřít menu" data-menu-toggle>
      <svg class="menu-open-icon" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" /></svg>
      <svg class="menu-close-icon hidden" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m5 5 12 12M17 5 5 17" /></svg>
    </button>
  </div>

  <div id="mobile-menu" hidden class="absolute inset-x-0 top-full max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-line bg-paper text-ink shadow-panel lg:hidden" data-mobile-menu>
    <nav aria-label="Mobilní navigace" class="container-x flex flex-col py-3">
      {nav.map((item) => (
        <a href={item.href} class:list={['flex min-h-12 items-center border-b border-line py-3 text-base font-medium', { 'text-wine': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <div class="grid gap-3 py-5">
        <a href="/oceneni-nemovitosti-zdarma/" class="btn btn-primary btn-lg w-full">Ocenění nemovitosti zdarma</a>
        <a href={site.broker.phoneHref} class="btn btn-outline btn-lg w-full">Zavolat {site.broker.phone}</a>
      </div>
    </nav>
  </div>
</header>
<div hidden class="fixed inset-0 z-30 bg-ink/45 backdrop-blur-[1px] lg:hidden" data-menu-backdrop aria-hidden="true"></div>

<script>
  const initMenu = () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');
    if (!btn || !menu || !backdrop || btn.dataset.ready) return;
    btn.dataset.ready = 'true';
    const openIcon = btn.querySelector<HTMLElement>('.menu-open-icon');
    const closeIcon = btn.querySelector<HTMLElement>('.menu-close-icon');

    const setOpen = (open: boolean, returnFocus = false) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
      menu.hidden = !open;
      backdrop.hidden = !open;
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      document.documentElement.classList.toggle('menu-open', open);
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else if (returnFocus) btn.focus();
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    backdrop.addEventListener('click', () => setOpen(false, true));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (btn.getAttribute('aria-expanded') !== 'true') return;
      if (event.key === 'Escape') {
        setOpen(false, true);
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = [btn, ...menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      } else if (!focusable.includes(document.activeElement as HTMLElement)) {
        event.preventDefault();
        first?.focus();
      }
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && btn.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  };
  /** Po odscrollování se logo sbalí do lišty – viz styl níž. */
  const initScrollState = () => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header || header.dataset.scrollReady) return;
    header.dataset.scrollReady = 'true';
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  };

  initMenu();
  initScrollState();
  document.addEventListener('astro:page-load', () => { initMenu(); initScrollState(); });
</script>

<style>
  /*
   * Logo na desktopu záměrně přesahuje lištu jako štítek (112 px proti 76 px vysoké liště).
   * Jakmile se stránka odscrolluje, štítek se sbalí do lišty, ať nepřekrývá obsah.
   */
  [data-header] :global(a[data-logo-link]),
  [data-header] :global(img[data-logo]) {
    transition: height 0.25s ease, padding 0.25s ease, background-color 0.25s ease;
  }
  @media (min-width: 1024px) {
    [data-header].is-scrolled :global(a[data-logo-link]) {
      align-self: center;
      padding: 0;
      background-color: transparent;
    }
    [data-header].is-scrolled :global(img[data-logo]) {
      height: 3.25rem; /* 52 px – vejde se do 76px lišty i s rezervou */
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-header] :global(a[data-logo-link]),
    [data-header] :global(img[data-logo]) { transition: none; }
  }
</style>
