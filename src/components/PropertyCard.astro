---
/** Karta nemovitosti podle referencí: fotka se štítkem, pod ní cena (serif), titulek a adresa ve verzálkách. */
import { Image } from 'astro:assets';
import { formatCena, shortFacts, lokalitaKratce, STATUS_LABEL, TYP_LABEL, type Nemovitost } from '@/lib/format';

interface Props { item: Nemovitost; eager?: boolean }
const { item, eager = false } = Astro.props;
const d = item.data;
const href = `/nemovitosti/${item.id}/`;
const inactive = d.status === 'prodano' || d.status === 'pronajato';
const facts = shortFacts(item);
const badge = d.status !== 'aktivni' ? STATUS_LABEL[d.status] : d.nabidka === 'pronajem' ? 'K pronájmu' : 'Na prodej';
---
<article
  class="group relative flex h-full flex-col"
  data-typ={d.typ}
  data-nabidka={d.nabidka}
  data-status={d.status}
  data-kraj={d.lokalita.kraj}
  data-cena={d.cena ?? ''}
  data-datum={d.datum.toISOString()}
>
  <a href={href} class="relative block aspect-[4/3] overflow-hidden bg-beton-deep" tabindex="-1" aria-hidden="true">
    <Image
      src={d.obrazky[0]}
      alt=""
      width={800}
      height={600}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      format="webp"
      quality={78}
      loading={eager ? 'eager' : 'lazy'}
      class:list={['h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]', { 'opacity-70 grayscale-[0.5]': inactive }]}
    />
    <span class:list={['absolute left-3 top-3 px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.16em]', inactive || d.status === 'rezervovano' ? 'bg-ink text-white' : 'bg-paper/95 text-ink']}>{badge}</span>
  </a>
  <div class="flex flex-1 flex-col pt-4">
    <p class:list={['num font-serif text-2xl font-medium', inactive ? 'text-mute line-through decoration-1' : 'text-ink']} style="font-variation-settings:'opsz' 32">{formatCena(item)}</p>
    <h3 class="mt-1.5 font-sans text-[0.95rem] font-medium leading-snug tracking-normal">
      <a href={href} class="after:absolute after:inset-0 hover:text-wine">{d.subtitle ?? d.title}</a>
    </h3>
    <p class="mt-2 text-[10px] font-medium uppercase tracking-[0.16em] text-mute">{lokalitaKratce(item)}{facts.length ? ` · ${facts.join(' · ')}` : ''}</p>
  </div>
</article>
