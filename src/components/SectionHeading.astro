---
interface Props { title: string; lead?: string; align?: 'left' | 'center'; as?: 'h1' | 'h2'; class?: string }
const { title, lead, align = 'left', as: Tag = 'h2', class: cls = '' } = Astro.props;
---
<div class:list={['max-w-2xl', { 'mx-auto text-center': align === 'center' }, cls]}>
  <Tag>{title}</Tag>
  {lead && <p class="mt-4 text-lg leading-relaxed text-ink-soft">{lead}</p>}
  <slot />
</div>
