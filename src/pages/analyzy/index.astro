---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import { formatDatum } from '@/lib/format';
const posts = (await getCollection('analyzy')).sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime());
---
<Base title="Analýzy realitního trhu – Vyškov, Brno, Praha" description="Ceny bytů a domů z realizovaných prodejů, doba prodeje, výnosy z pronájmu. Analýzy trhu pro Vyškovsko, Brno a Prahu od realitního analytika.">
  <section class="container-x py-14 lg:py-20">
    <div class="max-w-2xl">
      <h1>Analýzy trhu</h1>
      <p class="mt-4 text-lg text-ink-soft">Co se děje s cenami ve Vyškově, v Brně a v Praze – z katastru a z našich obchodů, ne z tiskových zpráv developerů.</p>
    </div>
    <ul class="mt-12 divide-y divide-line border-y border-line">
      {posts.map((p) => (
        <li class="grid gap-3 py-8 md:grid-cols-12 md:gap-8">
          <p class="text-sm text-mute md:col-span-3">{formatDatum(p.data.datum)}{p.data.lokalita ? ` · ${p.data.lokalita}` : ''}</p>
          <div class="md:col-span-9">
            <h2 class="text-2xl"><a href={`/analyzy/${p.id}/`} class="hover:text-wine">{p.data.title}</a></h2>
            <p class="measure mt-2 text-ink-soft">{p.data.perex}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
  <CtaBand title="Chcete vědět, co tato čísla znamenají pro vaši nemovitost?" text="Oceníme ji z realizovaných prodejů ve vašem okolí. Zdarma, do 2 pracovních dnů." />
</Base>
