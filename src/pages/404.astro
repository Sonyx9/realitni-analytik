---
import Base from '@/layouts/Base.astro';
---
<Base title="Stránka nenalezena" description="Tato stránka neexistuje." noindex>
  <section class="container-x py-24">
    <div class="mx-auto max-w-xl text-center">
      <h1>Tady nic není</h1>
      <p class="mt-5 text-lg text-ink-soft">Stránka byla přesunuta nebo nikdy neexistovala. Nemovitosti najdete v aktuální nabídce.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/nemovitosti/" class="btn btn-ink">Nabídka nemovitostí</a>
        <a href="/" class="btn btn-outline">Úvod</a>
      </div>
    </div>
  </section>
</Base>
