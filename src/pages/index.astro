---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import ValuationForm from '@/components/ValuationForm.astro';
import PropertyCard from '@/components/PropertyCard.astro';
import Testimonials from '@/components/Testimonials.astro';
import CtaBand from '@/components/CtaBand.astro';
import { sortNemovitosti, formatDatum, KATEGORIE_LABEL } from '@/lib/format';
import { site, sluzby } from '@/data/site';
import heroMakler from '@/assets/hero-makler.jpg';
import heroCut from '@/assets/hero-makler-cut.png';

const all = sortNemovitosti(await getCollection('nemovitosti'));
const active = all.filter((n) => n.data.status === 'aktivni');
const featured = [...active].sort((a, b) => Number(b.data.featured) - Number(a.data.featured)).slice(0, 3);
const analyzy = (await getCollection('blog')).sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime()).slice(0, 3);
const b = site.broker;
---
<Base
  title="Realitní analytik – prodej a ocenění nemovitostí Vyškov, Brno, Praha"
  description="Ing. Petr Dřímal: prodej nemovitostí postavený na datech z realizovaných prodejů. Ocenění zdarma do 2 dnů, příprava nemovitosti, profesionální prezentace. Vyškov, jižní Morava, Praha."
>
  <section class="overflow-hidden border-b border-line bg-beton">
    <div class="container-x grid px-0 sm:px-8 lg:grid-cols-12 lg:items-stretch">
      <div class="flex flex-col justify-center px-4 py-12 sm:px-0 sm:py-16 lg:col-span-7 lg:min-h-[660px] lg:py-20 lg:pr-16">
        <p class="eyebrow">Realitní makléř a analytik · Vyškov · Brno · Praha</p>
        <h1 class="mt-6 max-w-[13ch] text-[clamp(2.6rem,2rem+3vw,4.75rem)] leading-[0.98]">
          Znám skutečné ceny.<br />Připravím nemovitost.<br /><span class="text-wine">Prodám bez zbytečné slevy.</span>
        </h1>
        <p class="measure mt-7 max-w-[54ch] text-lg leading-relaxed text-ink-soft">
          Prodej založený na datech z trhu a katastru. Od správného ocenění přes prezentaci a prohlídky až po bezpečné předání klíčů.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/oceneni-nemovitosti-zdarma/" class="btn btn-primary btn-lg">Zjistit cenu nemovitosti</a>
          <a href="/nemovitosti/" class="btn btn-outline btn-lg">Prohlédnout nabídku</a>
        </div>
        <dl class="mt-10 grid grid-cols-2 gap-5 border-t border-ink/15 pt-6 sm:flex sm:gap-12">
          <div><dd class="num text-2xl font-semibold">{b.valuationsDone.toLocaleString('cs-CZ')}+</dd><dt class="mt-1 text-sm text-mute">provedených ocenění</dt></div>
          <div><dd class="num text-2xl font-semibold">{b.yearsOnMarket} let</dd><dt class="mt-1 text-sm text-mute">praxe na trhu</dt></div>
        </dl>
      </div>

      <figure class="relative mx-4 mb-4 min-h-[480px] overflow-hidden rounded-sm bg-wine sm:mx-0 sm:mb-0 sm:min-h-[560px] lg:col-span-5 lg:my-8 lg:min-h-[700px] lg:overflow-visible lg:[clip-path:inset(-3rem_-4rem_0_-4rem)]">
        <div class="absolute inset-x-6 top-6 flex items-center justify-between border-b border-white/25 pb-3 text-xs font-semibold tracking-[0.06em] text-white/75 sm:inset-x-8 sm:top-8" aria-hidden="true">
          <span>REALITNÍ ANALYTIK</span><span>01 / PETR DŘÍMAL</span>
        </div>
        <div class="absolute inset-x-[12%] bottom-0 top-[16%] border-x border-t border-white/20" aria-hidden="true"></div>
        <Image
          src={heroCut}
          alt={`${b.name}, ${b.role}`}
          width={1168}
          height={1908}
          widths={[480, 720, 1000]}
          sizes="(min-width: 1024px) 500px, 90vw"
          format="webp"
          quality={84}
          loading="eager"
          fetchpriority="high"
          class="absolute bottom-0 left-1/2 h-[86%] w-auto max-w-none -translate-x-1/2 object-contain object-bottom sm:h-[88%] lg:bottom-auto lg:top-0 lg:h-auto lg:w-[108%]"
        />
        <figcaption class="absolute bottom-5 left-5 border border-white/30 bg-ink/90 px-4 py-3 text-white shadow-panel sm:bottom-7 sm:left-7">
          <strong class="block font-serif text-xl font-medium leading-tight">{b.name}</strong>
          <span class="mt-1 block text-sm text-white/70">{b.role}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="border-b border-line bg-beton" aria-labelledby="oceneni-title">
    <!-- Nadpis přes celou šířku, formulář pod ním – ve dvou sloupcích vedle sebe vycházela pole úzká. -->
    <div class="container-x py-14 lg:py-16">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">Ocenění nemovitosti</p>
          <h2 id="oceneni-title" class="mt-3">Zjistěte, za kolik se může skutečně prodat</h2>
        </div>
        <p class="max-w-md text-ink-soft md:text-right">Podklad pro osobní ocenění. Výsledek zdarma do 2 pracovních dnů a bez závazku.</p>
      </div>
      <ValuationForm variant="bar" barTitle={false} class="mt-8" />
    </div>
  </section>

  <section aria-labelledby="nabidka-title">
    <div class="container-x py-16 lg:py-24">
      <div class="section-heading">
        <div><p class="eyebrow">Aktuální nabídka</p><h2 id="nabidka-title" class="mt-3">Vybrané nemovitosti</h2></div>
        <a href="/nemovitosti/" class="text-link">Celá nabídka ({active.length})</a>
      </div>
      {featured.length ? (
        <div class="mt-9 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((n, i) => <PropertyCard item={n} eager={i === 0} />)}
        </div>
      ) : (
        <p class="mt-8 text-ink-soft">Aktuálně nejsou zveřejněné žádné aktivní nabídky.</p>
      )}
    </div>
  </section>

  <section class="border-y border-line bg-beton" aria-labelledby="postup-title">
    <div class="container-x grid gap-10 py-16 lg:grid-cols-12 lg:gap-16 lg:py-24">
      <div class="lg:col-span-4">
        <p class="eyebrow">Jak spolupráce probíhá</p>
        <h2 id="postup-title" class="mt-3">Jasný postup od ceny po předání</h2>
        <p class="mt-5 text-ink-soft">Jeden člověk odpovídá za celý obchod a průběžně vysvětluje další krok.</p>
      </div>
      <ol class="divide-y divide-ink/15 border-y border-ink/15 lg:col-span-8">
        {sluzby.map((sl, i) => (
          <li class="grid gap-3 py-6 sm:grid-cols-[3rem_1fr_auto] sm:items-start sm:gap-5">
            <span class="num text-sm font-semibold text-wine">0{i + 1}</span>
            <div><h3 class="font-sans text-xl font-semibold tracking-normal">{sl.title}</h3><p class="mt-2 text-base leading-relaxed text-ink-soft">{sl.text}</p></div>
            <a href={sl.href} class="text-link sm:mt-1">Více</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="makler-title">
    <div class="container-x grid gap-10 py-16 lg:grid-cols-12 lg:items-center lg:gap-16 lg:py-24">
      <div class="lg:col-span-5">
        <Image src={heroMakler} alt={b.name} width={900} height={1100} widths={[500, 900]} sizes="(min-width:1024px) 40vw, 100vw" format="webp" quality={80} loading="eager" decoding="async" class="aspect-[4/5] w-full rounded-md object-cover object-top" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="eyebrow">Realitní analytik</p>
        <h2 id="makler-title" class="mt-3">Nejdřív odhadce pro banky, dnes makléř</h2>
        <p class="measure mt-6 text-lg leading-relaxed text-ink-soft">
          {b.name} pracuje s cenami realizovaných prodejů z katastru a s vlastními obchody. Před prodejem stanoví cenu, připraví nemovitost a provede majitele celým obchodem.
        </p>
        <dl class="mt-8 grid grid-cols-2 gap-6 border-y border-line py-6">
          <div><dd class="num text-2xl font-semibold">{b.valuationsDone.toLocaleString('cs-CZ')}+</dd><dt class="mt-1 text-sm text-mute">ocenění</dt></div>
          <div><dd class="num text-2xl font-semibold">{b.yearsOnMarket} let</dd><dt class="mt-1 text-sm text-mute">na trhu</dt></div>
        </dl>
        <a href="/o-nas/" class="btn btn-outline mt-8">Poznat Petra Dřímala</a>
      </div>
    </div>
  </section>

  <section class="bg-ink text-white" aria-labelledby="reference-title">
    <div class="container-x py-16 lg:py-24">
      <div class="section-heading border-white/20">
        <div><p class="eyebrow-light">Reference</p><h2 id="reference-title" class="mt-3 text-white">Zkušenosti klientů</h2></div>
        <a href="/reference/" class="text-link text-white decoration-white/40">Všechny reference</a>
      </div>
      <Testimonials class="mt-9 text-ink" />
    </div>
  </section>

  <section aria-labelledby="blog-title">
    <div class="container-x py-16 lg:py-20">
      <div class="section-heading">
        <div><p class="eyebrow">Blog</p><h2 id="blog-title" class="mt-3">Analýzy a praktické rady</h2></div>
        <a href="/blog/" class="text-link">Všechny články</a>
      </div>
      <ul class="mt-8 divide-y divide-line border-y border-line">
        {analyzy.map((a) => (
          <li class="grid gap-2 py-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-8">
            <div><p class="text-sm text-mute">{KATEGORIE_LABEL[a.data.kategorie]} · {formatDatum(a.data.datum)}</p><h3 class="mt-2 font-sans text-xl font-semibold tracking-normal"><a href={`/blog/${a.id}/`} class="hover:text-wine">{a.data.title}</a></h3></div>
            <a href={`/blog/${a.id}/`} class="text-link">Číst článek</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
